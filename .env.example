# Copy to .env for local development. Never commit .env.

# Runtime mode: development | test | production
NODE_ENV=development
# HTTP port the server listens on (default 3000)
PORT=3000
# Public base URL of the app, used in links and emails
PUBLIC_URL=http://localhost:3000
# PostgreSQL connection string
DATABASE_URL=postgres://spolu:spolu@localhost:5432/spolu
# Email of the first superadmin account, created on first boot
SUPERADMIN_EMAIL=admin@example.com
# Display name of the superadmin; optional, defaults to the part of the email before @.
SUPERADMIN_NAME=
# Secret for signing sessions and tokens, at least 32 characters
APP_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Build version shown by /api/health (the git SHA in deployed envs, default dev)
APP_VERSION=dev
# Directory for uploaded files (default ./data/files)
FILES_DIR=./data/files
# Built web app to serve; leave empty in dev (Vite serves the web)
WEB_DIST_DIR=
# Email driver: smtp (Mailpit in dev/test, Elastic Email SMTP when deployed) | elastic (Elastic Email HTTP API)
EMAIL_DRIVER=smtp
# SMTP host, used when EMAIL_DRIVER=smtp. 127.0.0.1, not localhost: nodemailer's own
# lookup of localhost times out on Node 26.
SMTP_HOST=127.0.0.1
# SMTP port, used when EMAIL_DRIVER=smtp
SMTP_PORT=1025
# SMTP login and password for an authenticated server (set both or neither); empty for Mailpit
SMTP_USER=
SMTP_PASSWORD=
# true = implicit TLS. Optional; defaults to true when SMTP_PORT is 465, else false
SMTP_SECURE=
# Elastic Email API key, required when EMAIL_DRIVER=elastic
ELASTIC_EMAIL_API_KEY=
# Sender address for all outgoing email
MAIL_FROM=Spolu <noreply@localhost>
# AI task split ("Turn into tasks"): openai (default) | fake (canned list-line splitter for dev and
# e2e; never on a server). With openai and no OPENAI_API_KEY the feature is off.
AI_PROVIDER=
# OpenAI API key; optional. Never logged.
OPENAI_API_KEY=
# OpenAI model (default gpt-5-mini)
OPENAI_MODEL=

# Used by Docker Compose and Caddy, not read by the app
# Public domain Caddy serves and gets a certificate for
DOMAIN=localhost
# Password of the PostgreSQL user in Docker Compose
POSTGRES_PASSWORD=spolu
