# Copy to .env for local development. Never commit .env.

# Runtime mode: development | test | production
NODE_ENV=development
# HTTP port the server listens on (default 3000)
PORT=3000
# Public base URL of the app, used in links and emails
PUBLIC_URL=http://localhost:3000
# PostgreSQL connection string
DATABASE_URL=postgres://spolu:spolu@localhost:5432/spolu
# Server tests only, read from the shell (not from this file): their database (default
# postgres://spolu:spolu@localhost:5432/spolu_test, created if missing) and the database used to
# create it (default postgres://spolu:spolu@localhost:5432/spolu). Parallel runs need their own.
# TEST_DATABASE_URL=
# ADMIN_DATABASE_URL=
# Email of the first superadmin account, created on first boot
SUPERADMIN_EMAIL=admin@example.com
# Display name of the superadmin; optional, defaults to the part of the email before @.
SUPERADMIN_NAME=
# Secret for signing sessions and tokens, at least 32 characters (openssl rand -base64 48).
# This placeholder is public: with NODE_ENV=production the app refuses to start with it.
APP_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Build version shown by /api/health (the git SHA in deployed envs, default dev)
APP_VERSION=dev
# Directory for uploaded files (default ./data/files)
FILES_DIR=./data/files
# Built web app to serve; leave empty in dev (Vite serves the web)
WEB_DIST_DIR=
# Email driver: smtp (Mailpit in dev/test, Elastic Email SMTP when deployed) | elastic (Elastic Email HTTP API)
EMAIL_DRIVER=smtp
# SMTP host, used when EMAIL_DRIVER=smtp. 127.0.0.1, not localhost: nodemailer's own
# lookup of localhost times out on Node 26.
SMTP_HOST=127.0.0.1
# SMTP port, used when EMAIL_DRIVER=smtp
SMTP_PORT=1025
# SMTP login and password for an authenticated server (set both or neither); empty for Mailpit
SMTP_USER=
SMTP_PASSWORD=
# true = implicit TLS. Optional; defaults to true when SMTP_PORT is 465, else false
SMTP_SECURE=
# Elastic Email API key, required when EMAIL_DRIVER=elastic or BULK_EMAIL_DRIVER=elastic
ELASTIC_EMAIL_API_KEY=
# Sender address for all outgoing email
MAIL_FROM=Help by eGrant <noreply@localhost>
# Bulk email (Phase 23). Sender of bulk email; optional, defaults to MAIL_FROM
MAIL_FROM_BULK=
# Bulk email driver: smtp (the SMTP settings above, Mailpit in dev/test) | elastic (Elastic Email
# /v4/emails, needs ELASTIC_EMAIL_API_KEY). Unset: the same as EMAIL_DRIVER. smtp needs EMAIL_DRIVER=smtp.
BULK_EMAIL_DRIVER=
# Upper bound of bulk emails a minute (default 120)
BULK_EMAIL_PER_MINUTE=
# With BULK_EMAIL_DRIVER=elastic: elastic (default; the footer link passes through Elastic's
# {unsubscribe:...} wrapper) | spolu (Spolu's own link and List-Unsubscribe header, only after
# Elastic's support removed its forced unsubscribe link)
BULK_EMAIL_UNSUBSCRIBE=
# Signing secret of Elastic's webhook (POST JSON, signed; ADR 0070), shown once when the webhook
# is created. Only with BULK_EMAIL_DRIVER=elastic. Set: POST /api/bulk-email/webhook exists and
# bulk email tracks opens and clicks. Unset (default): neither.
ELASTIC_WEBHOOK_SECRET=
# Web Push (VAPID). Set all three or none; none = push is off. Keys: pnpm --filter @spolu/server vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for the push services
VAPID_SUBJECT=
# webpush (default) | fake (tests and e2e only: records sends instead of sending).
# fake is refused when NODE_ENV=production unless PUSH_ALLOW_FAKE=1 (only the e2e server sets it)
PUSH_PROVIDER=
# With PUSH_PROVIDER=fake, append each push as a JSON line to this file
PUSH_FAKE_FILE=
# Milliseconds a group's email notifications wait so several events go out as one email (default 600000)
EMAIL_BATCH_DELAY_MS=
# Login code requests allowed per minute and IP, in production mode (default 10)
LOGIN_CODES_PER_MINUTE=
# Invite-link email submissions allowed per minute and IP (default 10)
JOIN_REQUESTS_PER_MINUTE=
# The one-time "What's new" popup (ADR 0067): on (default) | off (the e2e server only)
WHATS_NEW=
# AI task split ("Turn into tasks"): openai (default) | fake (canned list-line splitter for dev and
# e2e; never on a server). With openai and no OPENAI_API_KEY the feature is off.
# With NODE_ENV=production the app refuses to start with fake unless AI_ALLOW_FAKE=1 (e2e only).
AI_PROVIDER=
AI_ALLOW_FAKE=
# OpenAI API key; optional. Never logged.
OPENAI_API_KEY=
# OpenAI model (default gpt-5-mini); also writes the meeting summaries (Phase 30) and the ticket
# reply drafts ("Navrhnúť odpoveď")
OPENAI_MODEL=
# The chat composer's AI text tools (Phase 28: fix mistakes, make it formal, translate): a fast,
# cheap model of their own (default gpt-5.4-mini). AI_PROVIDER=fake gives a canned rewriter.
OPENAI_TEXT_MODEL=
# Its reasoning_effort: off (not sent; for models without reasoning) | none | minimal | low
# (default) | medium
OPENAI_TEXT_REASONING_EFFORT=
# Meeting transcription (Phase 30), also the chat composer's voice input (Phase 28): openai (default; uses OPENAI_API_KEY, off without it) |
# elevenlabs (needs ELEVENLABS_API_KEY) | fake (fixed transcript for dev and e2e; refused in
# production unless AI_ALLOW_FAKE=1).
TRANSCRIPTION_PROVIDER=
# OpenAI speech-to-text model (default gpt-transcribe; gpt-4o-mini-transcribe is cheaper)
OPENAI_TRANSCRIBE_MODEL=
# ElevenLabs Scribe key and model (default scribe_v2); never logged
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=
# The ffmpeg binary for meeting recordings (default ffmpeg on the PATH; the image has one)
FFMPEG_PATH=
# The media sandbox's Unix socket (ADR 0048). deploy/docker-compose.yml sets it on the app; empty
# = ffmpeg runs locally (dev, tests). The sandbox itself reads MEDIA_SOCKET and MEDIA_WORK_DIR.
MEDIA_SANDBOX_SOCKET=
# Ticket intake API (Phase 21): the shared Bearer key eGrant sends; at least 16 characters.
# Empty = POST /api/tickets/intake answers 503 intake_disabled. Never logged.
TICKETS_API_KEY=
# Microsoft Teams (T1, docs/integrations/teams.md): the Entra app Help calls Microsoft Graph as.
# All empty = the feature is off and hidden. Otherwise the tenant and client ids (GUIDs) and
# exactly one credential: TEAMS_CLIENT_SECRET, or TEAMS_CERT_PATH (a PEM file with the private
# key) + TEAMS_CERT_THUMBPRINT (the certificate's SHA-1 thumbprint from Entra). Never logged.
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_CERT_PATH=
TEAMS_CERT_THUMBPRINT=
# eGrant groups webhook (PUT /api/egrant/groups): its own Bearer key, at least 16 characters.
# Empty = TICKETS_API_KEY opens it too (both empty = 503 intake_disabled). Never logged.
EGRANT_GROUPS_API_KEY=

# Optional keys of their own for the other eGrant webhooks (at least 16 characters, never
# logged): the managers webhook (PUT /api/egrant/managers) and the projects webhook
# (PUT /api/egrant/projects/:project_id).
# Empty = they use TICKETS_API_KEY.
EGRANT_MANAGERS_API_KEY=
EGRANT_PROJECTS_API_KEY=
# Optional HMAC request signing per eGrant webhook (ADR 0042, docs/integrations/egrant.md,
# "Request signing"): at least 32 characters, never logged. Set = calls to that webhook must
# carry X-Spolu-Timestamp and X-Spolu-Signature, else 401. Empty = not signed (as before).
# Generate with: openssl rand -hex 32.
EGRANT_TICKETS_SIGNING_SECRET=
EGRANT_MANAGERS_SIGNING_SECRET=
EGRANT_GROUPS_SIGNING_SECRET=
EGRANT_PROJECTS_SIGNING_SECRET=
# Phase 33 projects fallback only if eGrant never sends projects: `programme` links an intake ticket without
# project_id to the client's project with that name (never creates one). Empty = off.
TICKETS_PROJECT_FIELD=

# Used by Docker Compose and Caddy, not read by the app
# Public domain Caddy serves and gets a certificate for
DOMAIN=localhost
# Password of the PostgreSQL user in Docker Compose. The app reads it only to refuse, with
# NODE_ENV=production, the placeholders spolu and change-me (also inside DATABASE_URL, except
# on localhost).
POSTGRES_PASSWORD=spolu
