# Caddy gets and renews the certificate for {$DOMAIN} automatically and redirects HTTP to HTTPS.
{$DOMAIN} {
	encode zstd gzip
	header {
		# HTTPS only for a year, subdomains too (no preload: that is hard to undo).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# No page of the app may be framed by another site (clickjacking).
		X-Frame-Options DENY
		# The enforced Content-Security-Policy (and Reporting-Endpoints) comes from the app itself
		# (apps/server/src/infra/http/security-headers.ts, ADR 0044), so the e2e run against the
		# built server gets the same policy. Caddy must not overwrite it: "?" sets this short one
		# only on an answer that has none (Caddy's own errors, for example a 502 while the app restarts).
		?Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		# Voice input needs the microphone on this origin; nothing needs the camera or location.
		Permissions-Policy "camera=(), geolocation=(), microphone=(self), payment=(), usb=()"
		-Server
	}
	# WebSocket upgrades (Socket.IO) are proxied automatically.
	reverse_proxy app:3000
}

# Old domains (REDIRECT_DOMAINS): each gets its own certificate and a permanent redirect to
# https://{$DOMAIN}{uri}. scripts/deploy.sh writes this file next to the Caddyfile on every
# deploy (scripts/lib.sh caddy_redirects); with no old domains it holds only comments.
import redirects.caddy
