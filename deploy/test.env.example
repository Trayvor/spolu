# Template for the test server's env file (never commit the real one). It is the TEST_ENV_FILE secret;
# scripts/deploy.sh uploads it as /opt/spolu/test/.env, next to docker-compose.yml.

# Image repository and tag to run; deploy.sh overwrites both with the deployed image and git SHA
IMAGE=ghcr.io/OWNER/spolu
TAG=latest
# Public domain Caddy serves and gets a certificate for. scripts/deploy.sh overrides DOMAIN,
# PUBLIC_URL and REDIRECT_DOMAINS (old domains redirected here) from its own variables.
DOMAIN=test.example.com
# PostgreSQL password, URL-safe, e.g. `openssl rand -hex 32`; compose builds DATABASE_URL from it, so DATABASE_URL is not set here.
# It only applies when the pgdata volume is first created. To change it later run ALTER USER spolu PASSWORD '...' first, then update this file.
POSTGRES_PASSWORD=change-me
# Optional: backup time (HH:MM, avoid 02:00-02:59: skipped by the March DST change) and timezone for the backup container
#BACKUP_HOUR=03:30
#BACKUP_TZ=Europe/Bratislava

# Public base URL of the app, used in links and emails
PUBLIC_URL=https://test.example.com
# Email of the first superadmin account, created on first boot
SUPERADMIN_EMAIL=admin@example.com
# Display name of the superadmin; optional, defaults to the part of the email before @.
SUPERADMIN_NAME=
# Secret for signing sessions and tokens, at least 32 characters (openssl rand -hex 32)
APP_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Deployed environments send real email through Elastic Email, here over authenticated SMTP.
# Alternative: EMAIL_DRIVER=elastic with ELASTIC_EMAIL_API_KEY=<api key> (and no SMTP_* lines);
# BULK_EMAIL_DRIVER then defaults to elastic too (unset, it follows EMAIL_DRIVER).
EMAIL_DRIVER=smtp
SMTP_HOST=smtp.elasticemail.com
# 465 = implicit TLS (SMTP_SECURE defaults to true on 465, false otherwise)
SMTP_PORT=465
# Elastic Email SMTP login and password (set both or neither)
SMTP_USER=change-me
SMTP_PASSWORD=change-me
# Sender address for all outgoing email
MAIL_FROM=Help by eGrant <noreply@example.com>
# Bulk email (Phase 23). Before the first real send switch to the Elastic API (the marketing
# endpoint /v4/emails); until then bulk email goes over the SMTP settings above. The key needs
# the SendHttp, ViewSuppressions and ModifySuppressions access levels.
# BULK_EMAIL_DRIVER=elastic
# ELASTIC_EMAIL_API_KEY=change-me
# Sender of bulk email on a domain verified in Elastic; optional, defaults to MAIL_FROM
# MAIL_FROM_BULK=eGrant <info@example.com>
# Upper bound of bulk emails a minute (default 120)
# BULK_EMAIL_PER_MINUTE=120
# elastic (default: the footer link passes through Elastic's unsubscribe wrapper) | spolu (only
# after Elastic's support removed its forced link and the List-Unsubscribe header setting is off)
# BULK_EMAIL_UNSUBSCRIBE=elastic
# Web Push (VAPID): set all three or none (none = push off). Generate the keys once per
# environment with `pnpm --filter @spolu/server vapid:generate`; never change them afterwards.
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
# mailto: or https: contact for the push services
VAPID_SUBJECT=mailto:admin@example.com
# Milliseconds a group's email notifications wait so several events go out as one (default 600000)
# EMAIL_BATCH_DELAY_MS=600000
# Login code requests allowed per minute and IP; an office behind one IP shares it (default 10)
# LOGIN_CODES_PER_MINUTE=10
# Invite-link email submissions per minute and IP (default 10)
# JOIN_REQUESTS_PER_MINUTE=10
# AI task split ("Turn into tasks" on a chat message). Optional: without a key the action is hidden.
# Never set AI_PROVIDER=fake on a server (it is a canned splitter for dev and e2e); in production the
# app refuses to start with it unless AI_ALLOW_FAKE=1, which only the e2e web server sets.
OPENAI_API_KEY=
# Optional, default gpt-5-mini (also the meeting summaries)
#OPENAI_MODEL=gpt-5-mini
# Meeting transcription (Phase 30): the OpenAI key above covers it (default model gpt-transcribe).
# To switch to ElevenLabs Scribe, set both lines below.
#OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
#TRANSCRIPTION_PROVIDER=elevenlabs
#ELEVENLABS_API_KEY=
# NODE_ENV, PORT, WEB_DIST_DIR, FILES_DIR and APP_VERSION are set by the image; DATABASE_URL by compose.
