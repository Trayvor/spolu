# Copy to deploy/.env on the test server (never commit it). Used by docker-compose.yml.

# Image repository and tag to run (the deploy script sets TAG to the git SHA)
IMAGE=ghcr.io/OWNER/spolu
TAG=latest
# Public domain Caddy serves and gets a certificate for
DOMAIN=test.example.com
# PostgreSQL password, URL-safe, e.g. `openssl rand -hex 32`; compose builds DATABASE_URL from it, so DATABASE_URL is not set here.
# It only applies when the pgdata volume is first created. To change it later run ALTER USER spolu PASSWORD '...' first, then update this file.
POSTGRES_PASSWORD=change-me
# Optional: backup time (HH:MM, avoid 02:00-02:59: skipped by the March DST change) and timezone for the backup container
#BACKUP_HOUR=03:30
#BACKUP_TZ=Europe/Bratislava

# Public base URL of the app, used in links and emails
PUBLIC_URL=https://test.example.com
# Email of the first superadmin account, created on first boot
SUPERADMIN_EMAIL=admin@example.com
# Secret for signing sessions and tokens, at least 32 characters (openssl rand -hex 32)
APP_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Deployed environments send real email through Elastic Email
EMAIL_DRIVER=elastic
# Elastic Email API key
ELASTIC_EMAIL_API_KEY=change-me
# Sender address for all outgoing email
MAIL_FROM=Spolu <noreply@example.com>
# NODE_ENV, PORT, WEB_DIST_DIR, FILES_DIR and APP_VERSION are set by the image; DATABASE_URL by compose.
