{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "noEmit": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src",
    "vite.config.ts",
    "pwa-manifest.ts",
    "pwa-precache.ts",
    "pwa-precache.test.ts",
    "vitest.config.ts"
  ]
}
