    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@spolu/shared": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "tsup": "^8.5.1",
