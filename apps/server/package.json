{
  "name": "@spolu/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "test": "vitest run && vitest run --config vitest.explain.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "vapid:generate": "node scripts/vapid-generate.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@resvg/resvg-wasm": "2.6.2",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fractional-indexing": "4.0.0",
    "nodemailer": "^10.1.1",
    "pg-boss": "^12.38.0",
    "postgres": "^3.4.9",
    "socket.io": "^4.8.4",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@spolu/shared": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
